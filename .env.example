# Copy to .env for local dev, or set these in Vercel project settings.
# The app runs fine with NONE of these set — flights show live-search links,
# hotels and tickets are link-outs, and nothing is ever fabricated.

# --- Live scores (set ONE; both free, no card) ---
FOOTBALLDATA_KEY=
APIFOOTBALL_KEY=
# APIFOOTBALL_WC_LEAGUE=1
# APIFOOTBALL_WC_SEASON=2026

# --- Flights: cached price estimates (free, no card, not deprecated) ---
# Travelpayouts data API token (Profile -> API token after signup).
# Without it, flight panels still show live Google Flights / Skyscanner links.
TRAVELPAYOUTS_TOKEN=
# Optional: cached-fare market (defaults to "us" for US/CA/MX routes).
# TRAVELPAYOUTS_MARKET=us

# --- Tickets (optional; FIFA/SeatGeek/StubHub links work without it) ---
SEATGEEK_CLIENT_ID=

# Hotels need NO key — they are honest link-outs to Booking.com / Hotels.com.
