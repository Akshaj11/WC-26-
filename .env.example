# Copy to .env for local dev, or set these in Vercel project settings.
# The app runs without any of these — it just shows "add a key" states
# instead of fabricating prices.

# --- Live scores (set ONE) ---
FOOTBALLDATA_KEY=
APIFOOTBALL_KEY=
# APIFOOTBALL_WC_LEAGUE=1
# APIFOOTBALL_WC_SEASON=2026

# --- Flights + Hotels (Amadeus, one account for both) ---
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# AMADEUS_BASE=https://test.api.amadeus.com   # -> https://api.amadeus.com for prod

# --- Tickets (optional; links work without it) ---
SEATGEEK_CLIENT_ID=
